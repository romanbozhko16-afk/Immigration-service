# Copy to .env and fill in. Never commit .env.

# Anthropic API key (required only for features that call the model).
ANTHROPIC_API_KEY=

# Model used for ALL users (free and paid tiers get the same model and effort).
# Allowed: claude-sonnet-5-5 (default), claude-opus-5-5.
# claude-fable-5-1 is intentionally not allowed: it requires 30-day data retention.
LLM_MODEL=claude-sonnet-5-5

# Reasoning effort: low | medium | high | xhigh | max
LLM_EFFORT=high

# dev | test | prod
APP_ENV=dev

# SQLite for the demo; a postgresql+psycopg:// URL works the same way later.
DATABASE_URL=sqlite:///./data/cases.db

# Per-case encryption keys, stored apart from the case data (production: a managed KMS).
# Keep its backups on a separate, shorter retention than the case database.
KEYSTORE_URL=sqlite:///./data/keys.db

# Master key that encrypts the per-case keys. Required. Losing it makes all cases unreadable.
# Generate: uv run python scripts/generate_master_key.py
MASTER_KEY=
